# SentinelAI environment configuration.
# Copy this file to .env and fill in the blanks:  cp .env.example .env
# .env is gitignored; this example file is committed.

# Signs session cookies. Generate a real one before deploying anywhere:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local Ollama model used for AI threat explanations.
# Pull it first:  ollama pull llama3
OLLAMA_MODEL=llama3

# AbuseIPDB reputation lookups for source IPs shown on the alerts page.
# Get a free key at https://www.abuseipdb.com/account/api
# Leave blank to disable: reputation is simply shown as "not checked".
ABUSEIPDB_API_KEY=

# Optional overrides (defaults shown)
# DB_URL=sqlite+aiosqlite:///./sentinelai.db
# UPLOAD_DIR=uploads
